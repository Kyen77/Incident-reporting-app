rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /incidents/{document} {
      allow read, write: if request.auth != null;
    }
    match /hotspots/{document} {
      allow read, write: if request.auth != null;
    }
    match /notifications/{document} {
      allow read, write: if request.auth != null;
    }
    match /users/{document} {
      allow read, write: if request.auth != null;
    }
  }
}
